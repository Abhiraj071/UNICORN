<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files or directories immediately if they exist at root
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map static asset folders if serving from root document directory
  RewriteRule ^images/(.*)$ frontend/dist/images/$1 [L]
  RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]
  RewriteRule ^mp3/(.*)$ frontend/dist/mp3/$1 [L]

  # Fallback all client routes to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
